# ============================================================================
# SONGZY — Environment variables
# Copy this file to `.env.local` (local dev) or paste values into Vercel
# Project Settings → Environment Variables (production).
# Every variable is OPTIONAL at runtime: if missing, the related feature
# no-ops gracefully (no crash) — the site stays live.
# ============================================================================

# === Stripe ==================================================================
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# For test mode, use sk_test_... / pk_test_... / whsec_...

# === Stripe Price IDs ========================================================
# Dashboard → Products — create 3 products (one Price each, EUR):
#   "Songzy Quick"    €19   → price_xxx
#   "Songzy Personal" €39   → price_xxx
#   "Songzy Premium"  €69   → price_xxx
STRIPE_PRICE_QUICK_EUR=price_xxx
STRIPE_PRICE_PERSONAL_EUR=price_xxx
STRIPE_PRICE_PREMIUM_EUR=price_xxx

# Add-on prices (one-off, Stripe Products → New Product → Add price)
STRIPE_PRICE_ADDON_EXTENDED=price_xxx
STRIPE_PRICE_ADDON_SECOND_VOICE=price_xxx

# Optional GBP mirror prices (create duplicate products in GBP)
STRIPE_PRICE_QUICK_GBP=
STRIPE_PRICE_PERSONAL_GBP=
STRIPE_PRICE_PREMIUM_GBP=
STRIPE_PRICE_ADDON_EXTENDED_GBP=
STRIPE_PRICE_ADDON_SECOND_VOICE_GBP=

# === Resend (transactional email) ===========================================
# resend.com → API Keys → Create
RESEND_API_KEY=re_xxx
# Must be a VERIFIED sender on a verified domain
RESEND_FROM_EMAIL=hello@songzy.com
RESEND_REPLY_TO=hello@songzy.com
# Founder inbox for new-order notifications
FOUNDER_EMAIL=hello@songzy.com

# === Neon Postgres (via Vercel Marketplace) =================================
# Auto-wired when you add Neon from Vercel → Storage → Create Database
POSTGRES_URL=postgres://xxx
POSTGRES_URL_NON_POOLING=postgres://xxx
POSTGRES_PRISMA_URL=postgres://xxx
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# === Vercel Blob Storage ====================================================
# Auto-wired when you create a Blob store in Vercel → Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# === Iubenda (cookie consent + privacy) ====================================
# iubenda.com → Cookie Solution → copy the site ID from the embed code
NEXT_PUBLIC_IUBENDA_SITE_ID=
NEXT_PUBLIC_IUBENDA_COOKIE_POLICY_ID=

# === Analytics ==============================================================
# analytics.google.com → GA4 property → Measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA4_ID=
# business.facebook.com → Events Manager → Pixel ID (numeric string)
NEXT_PUBLIC_META_PIXEL_ID=
# ads.tiktok.com → Events Manager → Pixel ID (alphanumeric)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# === Admin ==================================================================
# Password for /admin.html — CHANGE BEFORE LAUNCH. Generate 32+ random chars.
ADMIN_PASSWORD=changeme-xxxxxxxxxxxxxxxx

# === Site ===================================================================
SITE_URL=https://songzy.com
CONTACT_EMAIL=hello@songzy.com
NEXT_PUBLIC_SITE_URL=https://songzy.com
